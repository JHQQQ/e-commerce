<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mitsuha754.ecommerce.mapper.AuthMapper">

    <select id="login" resultType="com.mitsuha754.ecommerce.entity.User">
        select id, username, password, role, status, balance
        from user
        where username=#{userName}
    </select>

    <select id="checkUsername" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM user WHERE username = #{userName}
        )
    </select>

    <select id="getUserNameById" resultType="java.lang.String">
        SELECT username FROM user
        WHERE id = #{userId}
    </select>

    <insert id="register">
        INSERT INTO user (username, password)
        VALUES (#{userName}, #{password})
    </insert>

</mapper>